---
interface Props { kind: 'sphere' | 'cylinder' | 'plane' }
const { kind } = Astro.props;
const label = kind === 'sphere' ? 'A spherical Gaussian surface around a spherical charge distribution.'
  : kind === 'cylinder' ? 'A cylindrical Gaussian surface coaxial with an infinite line of charge.'
  : 'A pillbox Gaussian surface straddling an infinite charged sheet.';
---
<svg viewBox="0 0 480 210" role="img" aria-label={label} class="mx-auto my-5 w-full max-w-md"
  style="color:var(--text-primary)">
  {kind === 'sphere' ? <>
    <ellipse cx="240" cy="105" rx="82" ry="82" fill="var(--accent-blue)" fill-opacity="0.06" stroke="var(--accent-blue)" stroke-width="2" stroke-dasharray="6 4" />
    <ellipse cx="240" cy="105" rx="82" ry="24" fill="none" stroke="var(--accent-blue)" opacity="0.5" />
    <circle cx="240" cy="105" r="36" fill="var(--accent-red)" fill-opacity="0.2" stroke="var(--accent-red)" />
    <text x="240" y="111" text-anchor="middle" fill="currentColor">+Q</text>
    <path d="M 240 105 L 310 65" stroke="currentColor" /><text x="278" y="73" fill="currentColor">r</text>
    <text x="350" y="110" fill="currentColor">E radial</text>
  </> : kind === 'cylinder' ? <>
    <path d="M 125 65 L 350 65 M 125 155 L 350 155" stroke="var(--accent-blue)" stroke-dasharray="6 4" />
    <ellipse cx="125" cy="110" rx="23" ry="45" fill="var(--accent-blue)" fill-opacity="0.08" stroke="var(--accent-blue)" />
    <ellipse cx="350" cy="110" rx="23" ry="45" fill="var(--accent-blue)" fill-opacity="0.08" stroke="var(--accent-blue)" />
    <path d="M 50 110 L 425 110" stroke="var(--accent-red)" stroke-width="3" />
    <text x="67" y="96" fill="currentColor">λ</text><text x="230" y="180" fill="currentColor">length L</text>
    <path d="M 240 110 L 240 65" stroke="currentColor" /><text x="250" y="90" fill="currentColor">r</text>
    <text x="192" y="40" fill="currentColor">E outward</text>
  </> : <>
    <path d="M 125 70 L 310 30 L 365 145 L 180 185 Z" fill="var(--accent-red)" fill-opacity="0.15" stroke="var(--accent-red)" />
    <path d="M 190 73 L 300 73 M 190 143 L 300 143" stroke="var(--accent-blue)" stroke-dasharray="6 4" />
    <ellipse cx="190" cy="108" rx="17" ry="35" fill="var(--accent-blue)" fill-opacity="0.1" stroke="var(--accent-blue)" />
    <ellipse cx="300" cy="108" rx="17" ry="35" fill="var(--accent-blue)" fill-opacity="0.1" stroke="var(--accent-blue)" />
    <text x="176" y="164" fill="currentColor">A</text><text x="294" y="164" fill="currentColor">A</text>
    <text x="90" y="112" fill="currentColor">← E</text><text x="340" y="112" fill="currentColor">E →</text>
    <text x="280" y="56" fill="currentColor">σ</text>
  </>}
</svg>
