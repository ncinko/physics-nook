---
interface Props {
  title?: string;
  intro?: string;
}

const {
  title = 'Problem Solving',
  intro,
} = Astro.props;
---

<section class="problem-solving not-prose my-12">
  <h2 class="type-label m-0 text-[var(--accent-blue)]">{title}</h2>
  {intro && (
    <p class="type-supporting mt-2 mb-0 max-w-3xl">
      {intro}
    </p>
  )}

  <div class="mt-3 border-t border-[var(--grid-line)]">
    <slot />
  </div>
</section>
