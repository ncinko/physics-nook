---
const stageWidth = 188;
const stageHeight = 116;
const centerX = 94;
const centerY = 28;
const radius = 68;
const maxAngle = 1.08;
const bottomY = centerY + radius;

const pointAt = (theta: number) => ({
  x: centerX + radius * Math.sin(theta),
  y: centerY + radius * Math.cos(theta),
});

const createTrackPath = () => {
  const points = Array.from({ length: 42 }, (_, index) => {
    const theta = -maxAngle + (index / 41) * (maxAngle * 2);
    const point = pointAt(theta);
    return `${index === 0 ? 'M' : 'L'} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`;
  });

  return points.join(' ');
};

const trackPath = createTrackPath();

const states = [
  {
    label: 'High on the side',
    title: 'Potential-heavy start',
    theta: 0.94,
    accent: 'var(--accent-red)',
    height: 'large',
    speed: 'small',
    ledger: 'Gravitational potential energy dominates while the cart is high above the bottom.',
  },
  {
    label: 'Bottom crossing',
    title: 'Kinetic peak',
    theta: 0,
    accent: '#0f766e',
    height: 'minimum',
    speed: 'largest',
    ledger: 'Near the bottom, most of the tracked energy is kinetic because the cart is moving fastest.',
  },
  {
    label: 'After friction acts',
    title: 'Thermal gain',
    theta: 0.08,
    accent: '#b45309',
    height: 'small',
    speed: 'fading',
    ledger: 'With friction, mechanical energy is converted into thermal energy and the cart eventually settles near the bottom.',
  },
];
---

<section class="not-prose my-10 overflow-hidden rounded-[2rem] border border-[var(--grid-line)] bg-[var(--sim-bg)] shadow-sm">
  <div class="border-b border-[var(--grid-line)] px-6 py-5">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-[var(--accent-blue)]">Energy Ledger</p>
    <h3 class="m-0 text-2xl font-semibold tracking-tight text-[color:var(--text-primary)]">Track what changes form as the cart moves.</h3>
    <p class="mt-3 mb-0 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)]">
      The same system can look very different from one moment to the next. High on the track the energy is mostly stored as height, near the bottom it is mostly motion, and with friction some of that mechanical energy is transferred into thermal energy.
    </p>
  </div>

  <div class="grid gap-px bg-[var(--grid-line)] lg:grid-cols-3">
    {states.map((state) => {
      const cart = pointAt(state.theta);
      return (
        <article class="bg-[var(--bg-primary)] p-5">
          <p class="m-0 text-xs font-semibold uppercase tracking-[0.18em]" style={`color:${state.accent};`}>
            {state.label}
          </p>
          <h4 class="mt-3 mb-2 text-lg font-semibold text-[color:var(--text-primary)]">{state.title}</h4>

          <div class="rounded-2xl border border-[var(--grid-line)] bg-[color-mix(in_srgb,var(--sim-bg)_82%,white)] p-3 shadow-sm">
            <svg viewBox={`0 0 ${stageWidth} ${stageHeight}`} class="h-auto w-full" role="img" aria-label={`${state.title} energy snapshot`}>
              <defs>
                <linearGradient id="energy-track-fill" x1="0%" x2="0%" y1="0%" y2="100%">
                  <stop offset="0%" stop-color="color-mix(in srgb, var(--accent-blue) 12%, white)" />
                  <stop offset="100%" stop-color="color-mix(in srgb, var(--accent-blue) 3%, var(--bg-primary))" />
                </linearGradient>
              </defs>
              <path
                d={`${trackPath} L ${pointAt(maxAngle).x.toFixed(2)} ${(stageHeight - 10).toFixed(2)} L ${pointAt(-maxAngle).x.toFixed(2)} ${(stageHeight - 10).toFixed(2)} Z`}
                fill="url(#energy-track-fill)"
                opacity="0.9"
              />
              <path
                d={trackPath}
                fill="none"
                stroke="color-mix(in srgb, var(--text-primary) 72%, transparent)"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <line
                x1={cart.x}
                x2={cart.x}
                y1={cart.y}
                y2={bottomY}
                stroke="color-mix(in srgb, var(--text-muted) 62%, transparent)"
                stroke-width="1.5"
                stroke-dasharray="4 5"
              />
              <circle
                cx={cart.x}
                cy={cart.y - 5}
                r="11"
                fill="color-mix(in srgb, var(--bg-primary) 90%, white)"
                stroke={state.accent}
                stroke-width="3"
              />
              <circle
                cx={cart.x}
                cy={cart.y - 5}
                r="3.2"
                fill={state.accent}
              />
              <circle cx={centerX} cy={bottomY} r="3" fill="color-mix(in srgb, var(--text-primary) 42%, transparent)" />
            </svg>
          </div>

          <div class="mt-4 space-y-2 rounded-2xl border border-[var(--grid-line)] bg-[var(--surface-elevated)] p-4 shadow-sm">
            <div class="flex items-center justify-between gap-4 text-sm">
              <span class="text-[color:var(--text-muted)]">Height</span>
              <span class="font-semibold text-[color:var(--text-primary)]">{state.height}</span>
            </div>
            <div class="flex items-center justify-between gap-4 text-sm">
              <span class="text-[color:var(--text-muted)]">Speed</span>
              <span class="font-semibold text-[color:var(--text-primary)]">{state.speed}</span>
            </div>
            <p class="m-0 rounded-xl px-3 py-2 text-sm leading-6" style={`background:color-mix(in srgb, ${state.accent} 10%, var(--bg-primary)); color:${state.accent};`}>
              {state.ledger}
            </p>
          </div>
        </article>
      );
    })}
  </div>
</section>
