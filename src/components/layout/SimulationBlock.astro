---
interface Props {
  title?: string;
  description?: string;
  width?: 'wide' | 'full';
  /** 'tall' for a simulation that needs vertical room at standard width. */
  height?: 'standard' | 'tall';
  showHeader?: boolean;
  showFullscreen?: boolean;
  /**
   * Draws the fullscreen toggle as a solid accent button rather than a quiet
   * one. For the few simulations where going fullscreen is part of doing the
   * activity rather than a convenience — Motion Match is read from across a
   * room — and the control is otherwise easy to miss in the corner.
   */
  highlightFullscreen?: boolean;
}

const {
  title,
  description,
  width = 'wide',
  height = 'standard',
  showHeader = true,
  showFullscreen = true,
  highlightFullscreen = false,
} = Astro.props;

const breakoutClass =
  width === 'full'
    ? 'w-[calc(100vw-2rem)] max-w-none sm:w-screen'
    : 'w-[calc(100vw-2rem)] max-w-7xl sm:w-screen';
---

<section class={`not-prose relative left-1/2 my-10 -translate-x-1/2 sm:px-6 lg:px-8 ${breakoutClass}`}>
  <div
    data-simulation-block
    class="simulation-shell relative flex flex-col overflow-hidden rounded-[var(--radius-panel)] border border-theme-grid bg-[var(--sim-bg)] shadow-sm"
  >
    {showFullscreen && (
      <button
        type="button"
        data-simulation-fullscreen-toggle
        class:list={[
          'absolute top-4 right-4 z-20 rounded-[var(--radius-control)] px-3 py-2 text-xs font-semibold uppercase tracking-[0.1em] shadow-sm transition-colors',
          highlightFullscreen
            ? 'border border-[color:color-mix(in_srgb,var(--accent-blue)_45%,var(--grid-line))] bg-[var(--accent-blue)] text-white shadow-md ring-2 ring-[color:color-mix(in_srgb,var(--accent-blue)_25%,transparent)] hover:brightness-110'
            : 'border border-theme-grid bg-[var(--surface-elevated)] text-theme-text hover:border-theme-blue hover:text-theme-blue',
        ]}
        aria-label="Enter fullscreen"
      >
        Fullscreen
      </button>
    )}
    {showHeader && (title || description) && (
      <header class="border-b border-theme-grid bg-[var(--surface-elevated)] px-5 py-4 pr-28 backdrop-blur">
        {title && <h2 class="type-title m-0 text-[color:var(--text-primary)]">{title}</h2>}
        {description && <p class="mt-1 mb-0 text-sm text-[var(--text-muted)]">{description}</p>}
      </header>
    )}
    <div
      class:list={[
        'simulation-content flex-1',
        // Written out rather than interpolated: Tailwind scans for literal
        // class names, and a computed one emits no CSS at all.
        height === 'tall' ? 'min-h-[34rem]' : 'min-h-[24rem]',
      ]}
    >
      <div
        data-simulation-fallback
        role="alert"
        hidden
        class="m-5 rounded-[var(--radius-control)] border border-[var(--grid-line)] bg-[var(--surface-elevated)] px-5 py-4 text-sm text-[color:var(--text-primary)] shadow-sm"
      >
        <p class="m-0 font-semibold">This interactive didn't load.</p>
        <p class="mt-1 mb-0 text-[var(--text-muted)]">
          Reload the page. If it keeps happening, especially on a school network, the site's files may be
          filtered. The <a href="/diagnostics" class="text-[var(--accent-blue)] underline underline-offset-2">connection check</a>
          can tell you what's blocked.
        </p>
        <button
          type="button"
          data-simulation-reload
          class="mt-3 rounded-md border border-[var(--grid-line)] bg-[var(--accent-blue)] px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.1em] text-white shadow-sm hover:brightness-110"
        >
          Reload
        </button>
      </div>
      <slot />
    </div>
  </div>
</section>

<script>
  const syncButtonState = (block: Element, button: Element, isActive: boolean) => {
    button.textContent = isActive ? 'Exit Fullscreen' : 'Fullscreen';
    button.setAttribute('aria-label', isActive ? 'Exit fullscreen' : 'Enter fullscreen');
    block.classList.toggle('is-fallback-fullscreen', isActive && !document.fullscreenElement);
    document.body.classList.toggle('simulation-block-lock', isActive && !document.fullscreenElement);
  };

  document.querySelectorAll('[data-simulation-block]').forEach((block) => {
    const button = block.querySelector('[data-simulation-fullscreen-toggle]');
    if (!button) return;

    const updateFromFullscreenState = () => {
      const isNativeFullscreen = document.fullscreenElement === block;
      const isFallbackFullscreen = block.classList.contains('is-fallback-fullscreen');
      syncButtonState(block, button, isNativeFullscreen || isFallbackFullscreen);
    };

    button.addEventListener('click', async () => {
      const isNativeFullscreen = document.fullscreenElement === block;
      const isFallbackFullscreen = block.classList.contains('is-fallback-fullscreen');

      if (isNativeFullscreen) {
        await document.exitFullscreen?.();
        return;
      }

      if (isFallbackFullscreen) {
        syncButtonState(block, button, false);
        return;
      }

      if (block.requestFullscreen) {
        try {
          await block.requestFullscreen();
          return;
        } catch {
          // Fall back to CSS pseudo-fullscreen if the API is unavailable or blocked.
        }
      }

      syncButtonState(block, button, true);
    });

    document.addEventListener('fullscreenchange', updateFromFullscreenState);
  });

  /**
   * An island that never hydrates leaves an empty box, which reads as "the site
   * is broken" with nothing to act on. Show a notice instead when hydration
   * fails outright, or when an island is still unhydrated well after the block
   * scrolled into view (a filter stalling the request rather than refusing it).
   * BaseLayout reloads once first on a failure; this covers what that can't fix.
   */
  const STALL_MS = 12000;

  document.querySelectorAll<HTMLElement>('[data-simulation-block]').forEach((block) => {
    const fallback = block.querySelector<HTMLElement>('[data-simulation-fallback]');
    if (!fallback || !block.querySelector('astro-island')) return;

    const pending = () => block.querySelector('astro-island[ssr]') !== null;
    const show = () => {
      if ((window as Window & { __physicsNookReloading?: boolean }).__physicsNookReloading) return;
      fallback.hidden = false;
    };

    fallback
      .querySelector('[data-simulation-reload]')
      ?.addEventListener('click', () => window.location.reload());

    block.addEventListener('astro:hydration-error', () => {
      // Let BaseLayout's window listener decide on a reload first.
      window.setTimeout(show, 0);
    });
    block.addEventListener('astro:hydrate', () => {
      if (!pending()) fallback.hidden = true;
    });

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      window.setTimeout(() => {
        if (pending()) show();
      }, STALL_MS);
    });
    observer.observe(block);
  });
</script>

<style>
  :global(.simulation-shell:fullscreen),
  :global(.simulation-shell.is-fallback-fullscreen) {
    width: 100vw;
    max-width: none;
    height: 100vh;
    border-radius: 0;
  }

  :global(.simulation-shell:fullscreen),
  :global(.simulation-shell.is-fallback-fullscreen) {
    position: fixed;
    inset: 0;
    z-index: 70;
    margin: 0;
    /* The shell paints --sim-bg in normal flow, but fullscreen can reveal the
       UA backdrop (black) behind any part the content does not cover, so a
       light-theme simulation went dark. Restate a surface here; the page
       background is the right one, since fullscreen has no page around it. */
    background: var(--bg-primary);
  }

  :global(.simulation-shell:fullscreen)::backdrop {
    background: var(--bg-primary, #ffffff);
  }

  :global(.simulation-shell:fullscreen .simulation-content),
  :global(.simulation-shell.is-fallback-fullscreen .simulation-content) {
    min-height: 0;
    overflow: auto;
  }

  :global(body.simulation-block-lock) {
    overflow: hidden;
  }
</style>
