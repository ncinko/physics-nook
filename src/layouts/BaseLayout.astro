---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import { getPageMetaByPath } from '../data/modules';
import { buildDocumentTitle, siteMeta, type PageMeta } from '../data/site';

interface Props extends Partial<PageMeta> {
  showNav?: boolean;
  bodyClass?: string;
  mainClass?: string;
  wrapMain?: boolean;
}

const currentPath = Astro.url.pathname;
const defaults = getPageMetaByPath(currentPath);
const {
  title = defaults?.title ?? siteMeta.name,
  description = defaults?.description ?? siteMeta.description,
  canonicalPath = defaults?.canonicalPath ?? currentPath,
  image = defaults?.image ?? siteMeta.defaultSocialImage,
  noindex = defaults?.noindex ?? false,
  showNav = true,
  bodyClass = 'min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)]',
  mainClass = showNav ? 'pt-20' : '',
  wrapMain = true,
} = Astro.props;

const pageMeta = { title, description, canonicalPath, image, noindex };
const documentTitle = buildDocumentTitle(pageMeta);
const canonicalUrl = Astro.site ? new URL(pageMeta.canonicalPath, Astro.site).toString() : undefined;
const socialImageUrl = Astro.site ? new URL(pageMeta.image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" data-theme="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      const THEME_STORAGE_KEY = 'physics-nook-theme';
      const theme = (() => {
        try {
          const savedTheme = localStorage.getItem(THEME_STORAGE_KEY);
          if (savedTheme === 'pastel') return 'paper';
          if (savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'paper') {
            return savedTheme;
          }
        } catch {
          // Storage can be unavailable; the current page still supports themes.
        }
        return 'paper';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
    <script is:inline>
      // A page opened before a deploy still points at the old /_astro/ chunks,
      // which no longer exist, so its islands fail to hydrate. Reloading picks
      // up the new HTML. The timestamp guard allows one reload per few minutes,
      // so a chunk that is genuinely blocked (a school web filter) falls
      // through to SimulationBlock's visible notice instead of a reload loop.
      (() => {
        const RELOAD_KEY = 'physics-nook-chunk-reload';
        const RELOAD_WINDOW_MS = 5 * 60 * 1000;
        const MODULE_FAILURE =
          /dynamically imported module|module script failed|error loading dynamically imported|Unable to preload/i;

        const recover = () => {
          if (window.__physicsNookReloading) return;
          try {
            const last = Number(sessionStorage.getItem(RELOAD_KEY)) || 0;
            if (Date.now() - last < RELOAD_WINDOW_MS) return;
            sessionStorage.setItem(RELOAD_KEY, String(Date.now()));
          } catch {
            // Without storage there is no loop guard, so never reload.
            return;
          }
          window.__physicsNookReloading = true;
          window.location.reload();
        };

        window.addEventListener('astro:hydration-error', recover);
        window.addEventListener('vite:preloadError', recover);
        window.addEventListener('unhandledrejection', (event) => {
          const reason = event.reason;
          if (MODULE_FAILURE.test(String(reason?.message ?? reason ?? ''))) recover();
        });
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <meta name="description" content={pageMeta.description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {pageMeta.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={pageMeta.description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={pageMeta.description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
  </head>
  <body class={bodyClass}>
    {showNav && <Navbar currentPath={currentPath} />}
    {wrapMain ? (
      <main class={mainClass}>
        <slot />
      </main>
    ) : (
      <slot />
    )}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
