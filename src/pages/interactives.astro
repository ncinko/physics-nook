---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  interactiveEntries,
  interactiveKindLabels,
  interactiveModuleOrder,
  type InteractiveEntry,
  type InteractiveKind,
} from '../data/interactives';

const entriesByModule = interactiveModuleOrder
  .map((module) => ({
    module,
    entries: interactiveEntries.filter((entry) => entry.module === module),
  }))
  .filter((group) => group.entries.length > 0);

const totalCount = interactiveEntries.length;
const inlineCount = interactiveEntries.filter((entry) => entry.kind === 'inline').length;
const standaloneCount = interactiveEntries.filter((entry) => entry.kind === 'standalone').length;

const filterOptions: Array<{ id: 'all' | InteractiveKind; label: string; count: number }> = [
  { id: 'all', label: 'All', count: totalCount },
  { id: 'inline', label: 'Inline', count: inlineCount },
  { id: 'standalone', label: 'Standalone', count: standaloneCount },
];

const kindClasses: Record<InteractiveKind, string> = {
  inline:
    'border-[color:color-mix(in_srgb,var(--accent-blue)_36%,var(--grid-line))] bg-[color-mix(in_srgb,var(--accent-blue)_10%,transparent)] text-[var(--accent-blue)]',
  standalone:
    'border-[color:color-mix(in_srgb,var(--accent-red)_34%,var(--grid-line))] bg-[color-mix(in_srgb,var(--accent-red)_8%,transparent)] text-[var(--accent-red)]',
};

const countByKind = (entries: InteractiveEntry[], kind: InteractiveKind) =>
  entries.filter((entry) => entry.kind === kind).length;
---

<BaseLayout
  title="Interactives"
  description="Open Physics Nook inline interactives, standalone tools, and immersive physics sandboxes from one compact catalog."
  canonicalPath="/interactives"
>
  <main class="pt-20">
    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-12">
      <div class="mb-8 flex flex-col gap-5 border-b border-[var(--grid-line)] pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <p class="m-0 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent-blue)]">
            Physics Nook
          </p>
          <h1 class="mt-3 mb-0 text-4xl font-semibold tracking-tight text-[color:var(--text-primary)] sm:text-5xl">
            Interactives
          </h1>
          <p class="mt-4 mb-0 max-w-2xl text-sm leading-7 text-[color:var(--text-muted)] sm:text-base">
            Inline interactives are small, contextual scenes embedded in lessons. Standalone tools have room for deeper control.
          </p>
        </div>

        <div
          class="inline-flex w-full rounded-lg border border-[var(--grid-line)] bg-[var(--surface-elevated)] p-1 shadow-sm sm:w-auto"
          aria-label="Filter interactives"
          role="group"
        >
          {filterOptions.map((option) => (
            <button
              type="button"
              class="interactive-filter flex-1 rounded-md px-3 py-2 text-sm font-semibold text-[color:var(--text-muted)] transition-colors sm:flex-none"
              data-kind-filter={option.id}
              aria-pressed={option.id === 'all' ? 'true' : 'false'}
            >
              <span>{option.label}</span>
              <span class="ml-1 font-mono text-xs opacity-75">{option.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="space-y-8">
        {entriesByModule.map(({ module, entries }) => (
          <section class="interactive-module" data-module-section>
            <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-[color:var(--text-primary)]">
                  {module}
                </h2>
                <p class="mt-1 mb-0 text-sm text-[color:var(--text-muted)]">
                  {entries.length} total | {countByKind(entries, 'inline')} inline | {countByKind(entries, 'standalone')} standalone
                </p>
              </div>
            </div>

            <div class="overflow-hidden rounded-lg border border-[var(--grid-line)] bg-[var(--bg-primary)] shadow-sm">
              <div class="divide-y divide-[var(--grid-line)]">
                {entries.map((entry) => (
                  <a
                    href={entry.href}
                    class="interactive-entry group grid gap-3 px-4 py-4 transition-colors hover:bg-[color-mix(in_srgb,var(--accent-blue)_6%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-inset md:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1fr)_auto] md:items-center"
                    data-interactive-entry
                    data-kind={entry.kind}
                    target={entry.external ? '_blank' : undefined}
                    rel={entry.external ? 'noreferrer' : undefined}
                  >
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="m-0 text-base font-semibold text-[color:var(--text-primary)] group-hover:text-[var(--accent-blue)]">
                          {entry.title}
                        </h3>
                        {entry.experimental && (
                          <span class="rounded-md border border-[var(--grid-line)] px-2 py-0.5 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-muted)]">
                            Experimental
                          </span>
                        )}
                      </div>
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {entry.tags.map((tag) => (
                          <span class="rounded-md bg-[color-mix(in_srgb,var(--sim-bg)_86%,transparent)] px-2 py-1 text-xs text-[color:var(--text-muted)]">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>

                    <p class="m-0 text-sm leading-6 text-[color:var(--text-muted)]">
                      {entry.description}
                    </p>

                    <div class="flex items-center gap-2 md:justify-end">
                      <span class={`rounded-md border px-2.5 py-1 text-xs font-semibold ${kindClasses[entry.kind]}`}>
                        {interactiveKindLabels[entry.kind]}
                      </span>
                      <span class="rounded-md border border-[var(--grid-line)] px-2.5 py-1 text-xs font-semibold text-[color:var(--text-primary)] group-hover:border-[var(--accent-blue)] group-hover:text-[var(--accent-blue)]">
                        {entry.external ? 'Open external' : 'Open'}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>

      <p
        class="interactive-empty mt-8 hidden rounded-lg border border-[var(--grid-line)] bg-[var(--sim-bg)] px-4 py-3 text-sm text-[color:var(--text-muted)]"
        data-empty-state
      >
        No interactives match this filter.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-kind-filter]'));
  const entries = Array.from(document.querySelectorAll('[data-interactive-entry]'));
  const moduleSections = Array.from(document.querySelectorAll('[data-module-section]'));
  const emptyState = document.querySelector('[data-empty-state]');

  const setFilter = (kind: string) => {
    filterButtons.forEach((button) => {
      const isActive = button.getAttribute('data-kind-filter') === kind;
      button.setAttribute('aria-pressed', String(isActive));
    });

    entries.forEach((entry) => {
      const shouldShow = kind === 'all' || entry.getAttribute('data-kind') === kind;
      entry.toggleAttribute('hidden', !shouldShow);
    });

    let visibleSectionCount = 0;
    moduleSections.forEach((section) => {
      const visibleEntries = section.querySelectorAll('[data-interactive-entry]:not([hidden])').length;
      section.toggleAttribute('hidden', visibleEntries === 0);
      if (visibleEntries > 0) {
        visibleSectionCount += 1;
      }
    });

    emptyState?.classList.toggle('hidden', visibleSectionCount > 0);
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      setFilter(button.getAttribute('data-kind-filter') ?? 'all');
    });
  });
</script>

<style>
  .interactive-filter[aria-pressed='true'] {
    background: var(--accent-blue);
    color: white;
    box-shadow: 0 1px 4px color-mix(in srgb, var(--accent-blue) 26%, transparent);
  }
</style>
