---
import BaseLayout from './BaseLayout.astro';
import type { PageMeta } from '../data/site';

interface Props extends Partial<PageMeta> {}

const { title, description, canonicalPath, image, noindex } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  noindex={noindex}
  showNav={false}
  wrapMain={false}
>
  <slot />
</BaseLayout>
