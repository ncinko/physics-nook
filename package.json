{
  "name": "physics-nook-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "realtime": "node server/realtime.mjs",
    "game:dev": "vite --config apps/client/vite.config.ts",
    "game:build": "vite build --config apps/client/vite.config.ts",
    "game:build:pages": "vite build --config apps/client/vite.config.ts --outDir ../../dist",
    "game:preview": "vite preview --config apps/client/vite.config.ts",
    "game:server": "node --experimental-strip-types apps/server/src/server.ts",
    "game:server:watch": "node --experimental-strip-types --watch apps/server/src/server.ts",
    "test:kinematics": "node --experimental-strip-types tests/kinematics/run-tests.ts",
    "test:coaster": "node --experimental-strip-types tests/coaster/run-tests.ts",
    "test:oscillations": "node --experimental-strip-types tests/oscillations/run-tests.ts",
    "test:ripple": "node --experimental-strip-types tests/ripple/run-tests.ts",
    "test:solar": "node --experimental-strip-types tests/solar/run-tests.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/react": "^5.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.4",
    "katex": "^0.16.25",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19"
  }
}
