---
import { getLessonNeighbors } from '../../data/modules';

const { previous, next } = getLessonNeighbors(Astro.url.pathname);

const linkClass =
  'group block rounded-[var(--radius-control)] py-1 text-[color:var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--bg-primary)]';
const eyebrowClass = 'type-label block';
const titleClass =
  'type-title mt-1 block underline-offset-4 transition-colors duration-200 group-hover:text-[color:var(--accent-blue)] group-hover:underline';
---

{(previous || next) && (
  <footer class="not-prose mt-14 border-t border-[var(--grid-line)] pt-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {previous ? (
        <a
          href={previous.href}
          class={linkClass}
          aria-label={`Go to previous lesson: ${previous.title}`}
        >
          <span class={eyebrowClass}>← {previous.eyebrow}</span>
          <span class={titleClass}>{previous.title}</span>
        </a>
      ) : (
        <span class="hidden sm:block" aria-hidden="true"></span>
      )}

      {next && (
        <a
          href={next.href}
          class:list={[linkClass, 'sm:text-right']}
          aria-label={`Go to next lesson: ${next.title}`}
        >
          <span class={eyebrowClass}>{next.eyebrow} →</span>
          <span class:list={[titleClass, 'text-[color:var(--accent-blue)]']}>{next.title}</span>
        </a>
      )}
    </div>
  </footer>
)}
