---
import WavePoolSection from '../../components/waves/WavePoolSection';
import ImmersiveLayout from '../../layouts/ImmersiveLayout.astro';
---

<ImmersiveLayout title="Physics Nook | Deep Pool">
  <div class="relative isolate min-h-[100svh] overflow-hidden bg-theme-bg">
    <WavePoolSection
      client:load
      className="my-0 min-h-[100svh]"
      poolAriaLabel="Immersive wave pool; click or drag to create disturbances"
    />

    <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between p-4 sm:p-6">
      <a
        href="/waves"
        class="pointer-events-auto inline-flex items-center gap-2 rounded-full border border-theme-grid bg-[color-mix(in_srgb,var(--surface-elevated)_88%,transparent)] px-4 py-2 text-sm font-medium text-theme-text shadow-sm backdrop-blur transition-colors hover:border-theme-blue hover:text-theme-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-theme-blue focus-visible:ring-offset-2 focus-visible:ring-offset-theme-bg"
      >
        <span aria-hidden="true">&larr;</span>
        <span>Back to waves</span>
      </a>

      <div class="rounded-full border border-[color-mix(in_srgb,var(--grid-line)_74%,transparent)] bg-[color-mix(in_srgb,var(--surface-elevated)_76%,transparent)] px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-[color:var(--text-muted)] shadow-sm backdrop-blur">
        Deep Pool
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex justify-start p-4 sm:p-6">
      <div class="rounded-full border border-[color-mix(in_srgb,var(--grid-line)_68%,transparent)] bg-[color-mix(in_srgb,var(--surface-elevated)_74%,transparent)] px-3 py-1.5 text-xs text-[color:var(--text-muted)] shadow-sm backdrop-blur">
        Click or drag anywhere to sculpt the surface.
      </div>
    </div>
  </div>
</ImmersiveLayout>
