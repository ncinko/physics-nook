---
interface Props {
  title: string;
  prompt?: string;
  defaultOpen?: boolean;
  accent?: 'blue' | 'red';
}

const {
  title,
  prompt,
  defaultOpen = false,
  accent = 'blue',
} = Astro.props;

const focusClass = accent === 'red'
  ? 'focus-visible:ring-[var(--accent-red)]'
  : 'focus-visible:ring-[var(--accent-blue)]';
---

<details
  open={defaultOpen}
  class="worked-example border-b border-[var(--grid-line)]"
>
  <summary
    class={`group flex cursor-pointer list-none items-start gap-4 rounded-[var(--radius-control)] px-1 py-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)] ${focusClass}`}
  >
    <div class="min-w-0 flex-1">
      <h3 class="m-0 text-lg font-semibold tracking-tight text-[color:var(--text-primary)] transition-colors duration-200 group-hover:text-[color:var(--accent-blue)]">{title}</h3>
      {prompt && <p class="mt-1 mb-0 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)]">{prompt}</p>}
    </div>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="worked-example-chevron mt-1 h-5 w-5 flex-shrink-0 text-[color:var(--text-muted)] transition-transform duration-200"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M7.22 4.97a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06L11.19 10 7.22 6.03a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"
      />
    </svg>
  </summary>

  <div class="mb-6 ml-1 border-l-2 border-[var(--grid-line)] pl-4">
    <div class="worked-example-body prose prose-theme max-w-none">
      <slot />
    </div>
  </div>
</details>

<style>
  .worked-example summary::-webkit-details-marker {
    display: none;
  }

  .worked-example summary {
    list-style: none;
  }

  .worked-example[open] .worked-example-chevron {
    transform: rotate(90deg);
  }

  .worked-example-body :global(:first-child) {
    margin-top: 0;
  }

  .worked-example-body :global(:last-child) {
    margin-bottom: 0;
  }

  .worked-example-body :global(h4) {
    margin-top: 1.35rem;
    margin-bottom: 0.55rem;
  }

  .worked-example-body :global(ul),
  .worked-example-body :global(ol) {
    margin-top: 0.35rem;
  }

  .worked-example-body :global(h4[id^="given"] + ul) {
    list-style: none;
    padding-left: 0;
  }

  .worked-example-body :global(h4[id^="given"] + ul li) {
    padding-left: 0;
  }

  .worked-example-body :global(.katex-display) {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
</style>
