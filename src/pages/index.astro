---
import BaseLayout from '../layouts/BaseLayout.astro';
import WavePoolSection from '../components/waves/WavePoolSection';
import { astronomyPath, getModuleBySlug, measurementPath, mechanicsPath } from '../data/modules';

const measurementModule = getModuleBySlug('measurement');
const astronomyModule = getModuleBySlug('astronomy');
const kinematicsModule = getModuleBySlug('kinematics');

const homeCards = [
  {
    title: 'Lab Skills',
    href: measurementPath.href,
    description: measurementPath.summary,
    accent: measurementModule?.accent ?? '#b45309',
  },
  {
    title: astronomyModule?.title ?? 'Astronomy',
    href: astronomyPath.href,
    description: astronomyPath.summary,
    accent: astronomyModule?.accent ?? '#4f46e5',
  },
  {
    title: mechanicsPath.navLabel,
    href: mechanicsPath.href,
    description: mechanicsPath.summary,
    accent: kinematicsModule?.accent ?? '#0f766e',
  },
];
---

<BaseLayout>
  <div class="relative">
    <section class="relative h-[calc(100vh-5rem)] overflow-hidden">
      <div class="absolute inset-0 z-0 overflow-hidden">
        <WavePoolSection client:load className="!my-0 h-full !min-h-full" />
      </div>

      <div class="pointer-events-none relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-[clamp(2rem,15vh,9rem)] pt-16 md:px-6 lg:pt-24">
        <div class="pointer-events-none relative z-20">
          <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(circle_at_top_right,rgba(59,130,246,0.24),transparent_40%),radial-gradient(circle_at_bottom_left,rgba(14,165,233,0.2),transparent_36%)] blur-2xl"></div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {homeCards.map((card) => (
              <a
                href={card.href}
                class="pointer-events-auto group block rounded-[2rem] border border-theme-grid bg-[color:color-mix(in_srgb,var(--surface-elevated)_96%,transparent)] p-6 shadow-[0_28px_85px_rgba(15,23,42,0.14)] backdrop-blur transition-all duration-300 hover:-translate-y-1"
                style={`--card-accent: ${card.accent};`}
              >
                <h2 class="text-3xl font-semibold tracking-tight text-theme-text transition-colors duration-300 group-hover:text-[var(--card-accent)]">
                  {card.title}
                </h2>
                <p class="mt-3 max-w-xl text-sm leading-7 text-[var(--text-muted)]">
                  {card.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
