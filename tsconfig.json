{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "tailwind.config.mjs",
    "src/**/*",
    "functions/**/*"
  ],
  "exclude": [
    "apps",
    "dist",
    "packages",
    "server",
    "tests",
    "node_modules"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "node"
    ]
  }
}
