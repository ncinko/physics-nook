---
import { isNavItemActive, primaryNavItems } from '../../data/navigation';
import { normalizePath } from '../../utils/paths';
import SiteSearch from './SiteSearch';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const normalizedCurrentPath = normalizePath(currentPath);

const desktopLinkClasses = (isActive: boolean) =>
  [
    'inline-flex items-center rounded-full px-3 py-2 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]',
    isActive
      ? 'bg-[color-mix(in_srgb,var(--accent-blue)_14%,transparent)] text-[var(--accent-blue)]'
      : 'text-[color:var(--text-primary)] hover:text-[var(--accent-blue)]',
  ].join(' ');

const mobileLinkClasses = (isActive: boolean) =>
  [
    'block rounded-[1rem] border px-4 py-3 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface-elevated)]',
    isActive
      ? 'border-[color:color-mix(in_srgb,var(--accent-blue)_40%,var(--grid-line))] bg-[color-mix(in_srgb,var(--accent-blue)_12%,var(--surface-elevated))] text-[var(--accent-blue)]'
      : 'border-[var(--grid-line)] bg-[color-mix(in_srgb,var(--surface-elevated)_84%,transparent)] text-[color:var(--text-primary)] hover:border-[var(--accent-blue)]',
  ].join(' ');
---

<nav
  id="site-navbar"
  class="fixed top-0 z-50 w-full border-b border-[var(--grid-line)] bg-[color-mix(in_srgb,var(--bg-primary)_88%,transparent)] backdrop-blur transition-transform duration-300"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <div class="flex min-w-0 items-center gap-4 lg:gap-8">
      <a
        href="/"
        class="truncate text-lg font-semibold tracking-tight text-[color:var(--text-primary)] transition-colors hover:text-[var(--accent-blue)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]"
      >
        Physics Nook
      </a>

      <div class="hidden items-center gap-2 text-sm font-medium md:flex">
        {primaryNavItems
          .filter((item) => item.href !== '/')
          .map((item) => (
            <a
              href={item.href}
              class={desktopLinkClasses(isNavItemActive(item, normalizedCurrentPath))}
              aria-current={isNavItemActive(item, normalizedCurrentPath) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
      </div>
    </div>

    <div class="flex items-center gap-2">
      <SiteSearch client:idle />

      <button
        id="theme-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--grid-line)] bg-[var(--surface-elevated)] text-[color:var(--text-primary)] shadow-sm transition-all duration-300 hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]"
        aria-label="Theme: Paper. Switch to Light."
        title="Theme: Paper. Switch to Light."
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 40 40"
          fill="none"
          stroke="#777777"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-full w-full"
        >
          <path d="M20 20V1A19 19 0 0 1 36.454 29.5Z" fill="#ffffff" />
          <path d="M20 20L36.454 29.5A19 19 0 0 1 3.546 29.5Z" fill="#111827" />
          <path d="M20 20L3.546 29.5A19 19 0 0 1 20 1Z" fill="#f6f1e7" />
          <g stroke-width="2.2">
            <path class="theme-check theme-check-light" d="m25 14 2.5 2.5 4-4.5" stroke="#292722" />
            <path class="theme-check theme-check-dark" d="m16.5 30 2.5 2.5 4-4.5" stroke="#ffffff" />
            <path class="theme-check theme-check-paper" d="m8.5 14 2.5 2.5 4-4.5" stroke="#292722" />
          </g>
        </svg>
      </button>
      <span id="theme-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>

      <button
        id="mobile-nav-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--grid-line)] bg-[var(--surface-elevated)] text-[color:var(--text-primary)] shadow-sm transition-all duration-300 hover:border-[var(--accent-blue)] hover:text-[var(--accent-blue)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)] md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Open navigation menu"
      >
        <span class="sr-only">Open navigation menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    class="absolute inset-x-0 top-full z-40 hidden border-b border-[var(--grid-line)] bg-[color-mix(in_srgb,var(--bg-primary)_94%,transparent)] backdrop-blur md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="mx-auto max-w-6xl px-4 pb-4 pt-3 sm:px-6">
      <div class="space-y-4 rounded-[1.5rem] border border-[var(--grid-line)] bg-[color-mix(in_srgb,var(--surface-elevated)_94%,transparent)] p-4 shadow-[0_18px_50px_rgba(15,23,42,0.12)]">
        {primaryNavItems
          .filter((item) => item.href !== '/')
          .map((item) => (
            <a
              href={item.href}
              class={mobileLinkClasses(isNavItemActive(item, normalizedCurrentPath))}
              aria-current={isNavItemActive(item, normalizedCurrentPath) ? 'page' : undefined}
            >
              <span class="block text-sm font-semibold">{item.label}</span>
            </a>
          ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const THEME_STORAGE_KEY = 'physics-nook-theme';
  const navbar = document.getElementById('site-navbar');
  const themeToggle = document.getElementById('theme-toggle');
  const themeStatus = document.getElementById('theme-status');
  const themes = ['light', 'dark', 'paper'] as const;
  const themeNames = { light: 'Light', dark: 'Dark', paper: 'Paper' };
  const currentTheme = () => {
    const value = document.documentElement.getAttribute('data-theme');
    return value === 'light' || value === 'dark' ? value : 'paper';
  };
  const nextTheme = () => themes[(themes.indexOf(currentTheme()) + 1) % themes.length];
  const mobileToggle = document.getElementById('mobile-nav-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  let lastScrollY = window.scrollY;
  let isMobileMenuOpen = false;

  const setExpandedState = (button: Element | null, expanded: boolean) => {
    button?.setAttribute('aria-expanded', String(expanded));
  };

  const setPanelVisibility = (panel: Element | null, visible: boolean) => {
    if (!panel) return;
    panel.classList.toggle('hidden', !visible);
  };

  const syncMobileMenu = () => {
    setExpandedState(mobileToggle, isMobileMenuOpen);
    setPanelVisibility(mobilePanel, isMobileMenuOpen);

    if (mobileToggle) {
      mobileToggle.setAttribute(
        'aria-label',
        isMobileMenuOpen ? 'Close navigation menu' : 'Open navigation menu',
      );
      mobileToggle.title = isMobileMenuOpen ? 'Close navigation menu' : 'Open navigation menu';
    }
  };

  const closeMobileMenu = ({ restoreFocus = false } = {}) => {
    if (!isMobileMenuOpen) return;
    isMobileMenuOpen = false;
    syncMobileMenu();
    if (restoreFocus) {
      mobileToggle?.focus();
    }
  };

  const toggleMobileMenu = () => {
    isMobileMenuOpen = !isMobileMenuOpen;
    syncMobileMenu();
  };

  const onScroll = () => {
    if (!navbar) return;

    const currentScrollY = window.scrollY;

    if (isMobileMenuOpen) {
      navbar.classList.remove('-translate-y-full');
      lastScrollY = currentScrollY;
      return;
    }

    if (currentScrollY <= 0) {
      navbar.classList.remove('-translate-y-full');
      lastScrollY = currentScrollY;
      return;
    }

    if (currentScrollY > lastScrollY) {
      navbar.classList.add('-translate-y-full');
    } else if (currentScrollY < lastScrollY) {
      navbar.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY;
  };

  window.addEventListener('scroll', onScroll, { passive: true });

  const syncThemeToggle = () => {
    if (!themeToggle) return;
    const label = `Theme: ${themeNames[currentTheme()]}. Switch to ${themeNames[nextTheme()]}.`;
    themeToggle.setAttribute('aria-label', label);
    themeToggle.setAttribute('title', label);
  };

  themeToggle?.addEventListener('click', () => {
    const selectedTheme = nextTheme();
    document.documentElement.setAttribute('data-theme', selectedTheme);
    try {
      localStorage.setItem(THEME_STORAGE_KEY, selectedTheme);
    } catch {
      // Keep the applied theme and accessible state even if persistence fails.
    }
    syncThemeToggle();
    if (themeStatus) themeStatus.textContent = `${themeNames[selectedTheme]} theme selected.`;
  });

  mobileToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    toggleMobileMenu();
  });

  mobilePanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    if (
      isMobileMenuOpen &&
      !mobileToggle?.contains(target) &&
      !mobilePanel?.contains(target)
    ) {
      closeMobileMenu();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMobileMenu({ restoreFocus: true });
  });

  window.addEventListener('resize', () => {
    closeMobileMenu();
  });

  syncMobileMenu();
  syncThemeToggle();
</script>

<style>
  .theme-check { display: none; }
  :global(html:not([data-theme])) .theme-check-paper,
  :global([data-theme="light"]) .theme-check-light,
  :global([data-theme="dark"]) .theme-check-dark,
  :global([data-theme="paper"]) .theme-check-paper { display: initial; }
</style>
