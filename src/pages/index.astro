---
import BaseLayout from '../layouts/BaseLayout.astro';
import WavePoolSection from '../components/waves/WavePoolSection';
import OrbitSim from '../components/home/OrbitSim';
import ChargeSim from '../components/home/ChargeSim';
import BallSim from '../components/home/BallSim';
import { astronomyPath, electromagnetismPath, getModuleBySlug, mechanicsPath } from '../data/modules';

const astronomyModule = getModuleBySlug('astronomy');
const electromagnetismModule = getModuleBySlug('electromagnetism');
const kinematicsModule = getModuleBySlug('kinematics');

const homeCards = [
  {
    title: astronomyModule?.title ?? 'Astronomy',
    href: astronomyPath.href,
    id: 'astronomy',
    accent: astronomyModule?.accent ?? '#4f46e5',
  },
  {
    title: electromagnetismModule?.title ?? 'Electromagnetism',
    href: electromagnetismPath.href,
    id: 'electromagnetism',
    accent: electromagnetismModule?.accent ?? '#6366f1',
  },
  {
    title: mechanicsPath.navLabel,
    href: mechanicsPath.href,
    id: 'mechanics',
    accent: kinematicsModule?.accent ?? '#0f766e',
  },
];
---

<BaseLayout>
  <div class="relative">
    <section class="relative h-[calc(100vh-5rem)] overflow-hidden">
      <div class="absolute inset-0 z-0 overflow-hidden">
        <WavePoolSection client:load className="!my-0 h-full !min-h-full" />
      </div>

      <div class="pointer-events-none relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-4 pb-[clamp(2rem,15vh,9rem)] pt-16 md:px-6 lg:pt-24">
        <div class="pointer-events-none relative z-20">
          <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(circle_at_top_right,rgba(59,130,246,0.24),transparent_40%),radial-gradient(circle_at_bottom_left,rgba(14,165,233,0.2),transparent_36%)] blur-2xl"></div>
          <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
            {homeCards.map((card) => (
              <div
                class="pointer-events-auto group rounded-[2rem] border border-theme-grid bg-[color:color-mix(in_srgb,var(--surface-elevated)_96%,transparent)] p-4 shadow-[0_28px_85px_rgba(15,23,42,0.14)] backdrop-blur sm:p-6"
                style={`--card-accent: ${card.accent};`}
              >
                <a href={card.href} class="block">
                  <h2 class="text-2xl font-semibold tracking-tight text-theme-text transition-colors duration-300 hover:text-[var(--card-accent)] sm:text-3xl">
                    {card.title}
                  </h2>
                </a>
                <div class="mt-3 h-[7rem] overflow-hidden sm:mt-4 sm:h-[7.5rem] lg:h-[9.5rem] rounded-[var(--radius-control)] bg-[var(--surface-plot)]">
                  {card.id === 'astronomy' && <OrbitSim client:load />}
                  {card.id === 'electromagnetism' && <ChargeSim client:load />}
                  {card.id === 'mechanics' && <BallSim client:load />}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
