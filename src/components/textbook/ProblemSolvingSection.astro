---
interface Props {
  title?: string;
  intro?: string;
}

const {
  title = 'Problem Solving',
  intro,
} = Astro.props;
---

<section class="problem-solving not-prose my-12">
  <h2 class="m-0 text-2xl font-semibold tracking-tight text-[color:var(--text-primary)]">{title}</h2>
  {intro && (
    <p class="mt-3 mb-0 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)]">
      {intro}
    </p>
  )}

  <div class="mt-5 border-t border-[var(--grid-line)]">
    <slot />
  </div>
</section>
